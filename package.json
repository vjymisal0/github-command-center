{
  "name": "oss-tracker",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "test": "tsx --test packages/shared/src/*.test.ts apps/api/src/*.test.ts",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "postinstall": "npm run db:generate",
    "vercel-build": "npm run build -w packages/shared && npm run build -w apps/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
